# PUBLIC CONFIG ONLY — this file is bundled into the app as an asset
# and is readable by anyone who inspects the APK/IPA. Never put API keys,
# tokens, or credentials here; keep secrets server-side.
TILE_SERVER_URL=http://192.168.1.3:8050

# OAuth client registered in User Management API. This is public client
# configuration, not the Google client secret (which stays on the backend).
SOCIAL_OAUTH_CLIENT_ID=your-first-party-oauth-client-id
# Android/iOS callback. Register this exact URI under the OAuth client's allowlist.
SOCIAL_NATIVE_REDIRECT_URI=enterprise-flutter-app://auth/callback
# Web callback. For local web development, omit this and it resolves to auth.html.
# SOCIAL_WEB_REDIRECT_URI=https://app.example.com/auth.html
